# Copy to .env and adjust for your machine. Any variable left unset (or empty)
# falls back to the value in config.json.

# LLM backend: gpt4all | llamacpp | ollama | openai
LLM_BACKEND=gpt4all

# Path to the local GGUF model file (gpt4all and llamacpp backends)
LLM_MODEL_PATH=./llms/Llama-3.1-8B-Instruct-Q4_1.gguf

# Tokenizer chat template (llamacpp backend only)
LLM_CHAT_FORMAT=llama-3

# Model name and API endpoint (ollama backend only)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible API (openai backend only). Point OPENAI_BASE_URL at any
# compatible server, e.g. https://openrouter.ai/api/v1 or http://localhost:1234/v1
# (LM Studio). Local servers usually don't need an API key.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Header that carries the key. Authorization (default) sends "Bearer <key>";
# set e.g. x-api-key if your server or proxy expects the raw key in another header.
OPENAI_AUTH_HEADER=Authorization
# Max tokens per response. Reasoning models (e.g. Qwen3, DeepSeek-R1) think before
# answering and need a much larger budget, e.g. 8192.
OPENAI_MAX_TOKENS=512
# Reasoning/thinking toggle for reasoning models on llama.cpp-based servers
# (Qwen3, DeepSeek-R1, ...): true | false. Leave empty to use the server default;
# keep it empty for OpenAI itself, which rejects the underlying field.
# false is much faster (seconds instead of tens of seconds per call).
OPENAI_REASONING=

# Print stat-engine decisions (intent, target, emotion, reasoning): true | false
DEBUG_SHOW_LOGIC=false
